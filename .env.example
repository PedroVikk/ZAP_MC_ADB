# Copie para .env e ajuste. O .env NUNCA vai para o git.

# Onde o daemon do ZAP escuta (host:porta do proxy/API).
ZAP_BASE_URL=http://localhost:8080

# Chave da API do ZAP. Gere uma string longa e aleatoria.
# O mesmo valor entra no docker-compose (api.key) e aqui.
ZAP_API_KEY=troque-por-uma-chave-longa-aleatoria

# Lista de alvos AUTORIZADOS, separados por virgula (host ou URL).
# Deny by default: vazio = NADA e permitido. Subdominios de um host liberado
# tambem passam (ex.: "example.com" libera "api.example.com").
ZAP_ALLOWED_TARGETS=localhost,127.0.0.1

# Tempo maximo (segundos) que um scan pode rodar antes de ser parado.
ZAP_MAX_SCAN_SECONDS=900

# Pasta onde os relatorios gerados sao gravados.
ZAP_REPORT_DIR=reports

# Caminho do binario do Nuclei (aba Nuclei / nuclei_scan). Default: "nuclei" no PATH.
NUCLEI_PATH=nuclei

# Caminho do ADB (teste mobile). Default: "adb" no PATH.
ADB_PATH=adb
